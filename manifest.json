{
  "manifest_version": 3,
  "name": "CopyPasta",
  "version": "2.0.0",
  "description": "Restores copy, cut, and paste on sites that block it. Opt-in, per-site. No telemetry.",
  "icons": {
    "16": "icons/inactive-16.png",
    "32": "icons/inactive-32.png",
    "48": "icons/inactive-48.png",
    "128": "icons/inactive-128.png"
  },
  "action": {
    "default_popup": "popup.html",
    "default_icon": {
      "16": "icons/inactive-16.png",
      "32": "icons/inactive-32.png",
      "48": "icons/inactive-48.png",
      "128": "icons/inactive-128.png"
    }
  },
  "background": {
    "service_worker": "background.js",
    "type": "module"
  },
  "permissions": [
    "storage",
    "scripting",
    "tabs"
  ],
  "host_permissions": [
    "<all_urls>"
  ],
  "web_accessible_resources": [
    {
      "resources": [
        "clipboard-injector.js"
      ],
      "matches": [
        "<all_urls>"
      ]
    }
  ]
}
